{%- set initialisms = {"aws": "AWS", "http": "HTTP", "io": "IO", "s3": "S3", "s3gw": "S3GW"} -%}
{%- macro goname(s) -%}
{%- for w in s | replace("_", ".") | split(".") -%}{{ initialisms[w] or w | capitalize }}{%- endfor -%}
{%- endmacro -%}
// Code generated by weaver from model/. DO NOT EDIT.

package semconv

// Attribute keys used by the s3gw metrics.
const (
{%- for a in ctx.attributes %}
	// Attr{{ goname(a.name) }} is {{ a.name }}: {{ a.brief | trim | replace("\n", " ") }}
	Attr{{ goname(a.name) }} = "{{ a.name }}"
{%- endfor %}
)
{% for a in ctx.attributes if a.type.members is defined and (a.name.startswith("s3gw.") or a.name == "network.io.direction") %}
// Values of {{ a.name }}.
const (
{%- for mem in a.type.members %}
	{{ goname(a.name) }}{{ goname(mem.id) }} = "{{ mem.value }}"
{%- endfor %}
)
{% endfor %}
{%- for m in ctx.metrics %}
// {{ m.metric_name }} ({{ m.instrument }}): {{ m.brief | trim | replace("\n", " ") }}
const (
	Metric{{ goname(m.metric_name) }}            = "{{ m.metric_name }}"
	Metric{{ goname(m.metric_name) }}Unit        = "{{ m.unit }}"
	Metric{{ goname(m.metric_name) }}Description = "{{ m.brief | trim | replace("\n", " ") | replace("\"", "\\\"") }}"
)
{% endfor -%}
